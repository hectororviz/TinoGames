; Engine configuration file.
; Proyecto nuevo con Valentino: plataformas 2D cartoon para Android.
; Base mínima jugable (vertical slice): menú + una pantalla + un personaje.

config_version=5

[application]

config/name="Jueguito (prototipo)"
config/description="Vertical slice: menú con el héroe en portada + una pantalla jugable."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.53, 0.78, 0.92, 1)

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input]

