# --- Docker ---
DOCKER_TAG=latest

# Dominios publicos (resueltos por caddy-docker-proxy).
WEB_DOMAIN=juegos.mposw.com.ar
API_DOMAIN=api.juegos.mposw.com.ar

# --- Postgres ---
POSTGRES_USER=tinogames
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=tinogames

# --- Front (Vite) ---
# URL base de la API desde el navegador. El build de nginx la inyecta
# en los bundles estaticos; el juego no la usa todavia (compartir = Fase 1).
VITE_API_URL=https://api.juegos.mposw.com.ar
